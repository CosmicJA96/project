-- database: ./database.db

SELECT * FROM Planets;

--Planets except IDs
SELECT Name, Diameter_km, ImageURL, `Orbitalspeed-km/s`, Description, `Rotation-hrs`, `Age-BillionYrs` FROM Planets;

--Moons except IDs
SELECT Name, `Diameter-km`, ImageURL, `Orbitalspeed-km/s`, Description FROM Moons;

--Order Planets by Size
SELECT * FROM Planets
ORDER BY Diameter_km;

--Show [planet]'s moons
SELECT * FROM Moons
WHERE PlanetID = 5;

--show moon and size for a particular planet
SELECT  MoonID, Name, `Diameter-km`, ImageURL FROM Moons
WHERE PlanetID = 6;

--show planet name and image
SELECT Name, ImageURL FROM Planets;

--show particular planet
SELECT Name, Diameter_km, ImageURL, `Orbitalspeed-km/s`, Description, `Rotation-hrs`, `Age-BillionYrs` FROM Planets
WHERE ID = 5;

--specific planet
SELECT * FROM Planets
WHERE ID = 5;

SELECT ID, Name, Diameter_km, ImageURL FROM Planets;

--specific moon
SELECT * FROM Moons
WHERE MoonID = 3;